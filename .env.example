# Шаблон секретов проекта: скопируйте в .env и подставьте реальные значения.
# .env игнорируется git (см. .gitignore) и читается только docker compose.
#
# Ключ шифрования Spring Cloud Config Server: им расшифровываются {cipher}-значения
# из config-repo (например, пароль SMTP в notification-service.yml).
# Без него config-server стартует, но {cipher}-свойства не расшифруются,
# а зависимые сервисы упадут при использовании этих свойств.
# Для локального запуска config-server из IDE без docker задайте ENCRYPT_KEY
# в run-configuration приложения.
ENCRYPT_KEY=change-me
